{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ScriptHub 壳默认能力：shell 侧进程（sidecar）+ 端口协商事件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/scripthub-server",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/scripthub-server",
          "sidecar": true
        }
      ]
    }
  ]
}
